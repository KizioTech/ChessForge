{
  "name": "chessforge",
  "version": "0.6.0",
  "private": true,
  "description": "A personal chess improvement desktop workspace",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "start": "electron .",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const bin=path.join('node_modules','stockfish','bin');try{fs.mkdirSync('public',{recursive:true});fs.copyFileSync(path.join(bin,'stockfish-19-lite-single.js'),path.join('public','stockfish.js'));fs.copyFileSync(path.join(bin,'stockfish-19-lite-single.wasm'),path.join('public','stockfish.wasm'));fs.copyFileSync(path.join(bin,'stockfish-19-lite-single.wasm'),path.join('public','stockfish-19-lite-single.wasm'));}catch(e){}\"",
    "dist:app": "npm run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.kiziotech.chessforge",
    "productName": "ChessForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
